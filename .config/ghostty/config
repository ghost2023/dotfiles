font-family = "GeistMono Nerd Font"
font-style="Regular"
fullscreen = true
font-size = 9
theme = alacritty
keybind = alt+p=paste_from_clipboard
window-padding-x=0
window-padding-y=0
freetype-load-flags = hinting, force-autohint, no-monochrome
confirm-close-surface=false
app-notifications=false
window-decoration=false

background = "121212"
foreground = "D9E0EE"

################################
# Keybinds
################################

keybind = ctrl+enter=unbind
keybind = f11=toggle_fullscreen

